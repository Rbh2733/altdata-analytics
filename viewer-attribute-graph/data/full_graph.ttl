svod:LifecycleSignal a owl:Class ;
    rdfs:comment "A derived per-viewer lifecycle classification (active / at_risk / churned), computed from subscription history and viewing recency." .

svod:ViewingSummary a owl:Class ;
    rdfs:comment "A derived per-viewer rollup of total viewing activity." .

svod:Viewer a owl:Class ;
    rdfs:comment "A person whose viewing and subscription activity is tracked." .

svod:SubscriptionEvent a owl:Class ;
    rdfs:comment "A subscribe or churn event tying a viewer to a platform at a point in time." .

