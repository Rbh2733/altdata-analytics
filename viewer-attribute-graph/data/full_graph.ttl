@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix svod: <https://github.com/Rbh2733/altdata-analytics/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://github.com/Rbh2733/altdata-analytics/ontology> a owl:Ontology ;
    rdfs:comment "SVOD attention ontology: viewers, platforms, titles, genres, and derived affinity/lifecycle attributes." .

svod:affinityType a owl:DatatypeProperty ;
    rdfs:comment "One of: genre, brand." ;
    rdfs:domain svod:AffinityScore ;
    rdfs:range xsd:string .

svod:affinityWeight a owl:DatatypeProperty ;
    rdfs:comment "Normalized affinity weight in [0,1], share of a viewer's watch time attributable to this genre or platform." ;
    rdfs:domain svod:AffinityScore ;
    rdfs:range xsd:decimal .

svod:availableOn a owl:ObjectProperty ;
    rdfs:domain svod:Title ;
    rdfs:range svod:Platform .

svod:daysSinceLastView a owl:DatatypeProperty ;
    rdfs:domain svod:LifecycleSignal ;
    rdfs:range xsd:integer .

svod:derivedFromEventCount a owl:DatatypeProperty ;
    rdfs:comment "Provenance: number of raw ViewingEvents this score was aggregated from." ;
    rdfs:domain svod:AffinityScore ;
    rdfs:range xsd:integer .

svod:distinctTitlesWatched a owl:DatatypeProperty ;
    rdfs:domain svod:ViewingSummary ;
    rdfs:range xsd:integer .

svod:eventDate a owl:DatatypeProperty ;
    rdfs:domain svod:SubscriptionEvent ;
    rdfs:range xsd:date .

svod:eventPlatform a owl:ObjectProperty ;
    rdfs:domain svod:SubscriptionEvent ;
    rdfs:range svod:Platform .

svod:eventType a owl:DatatypeProperty ;
    rdfs:comment "One of: subscribe, churn." ;
    rdfs:domain svod:SubscriptionEvent ;
    rdfs:range xsd:string .

svod:forGenre a owl:ObjectProperty ;
    rdfs:domain svod:AffinityScore ;
    rdfs:range svod:Genre .

svod:forPlatform a owl:ObjectProperty ;
    rdfs:domain svod:AffinityScore ;
    rdfs:range svod:Platform .

svod:hasAffinityScore a owl:ObjectProperty ;
    rdfs:domain svod:Viewer ;
    rdfs:range svod:AffinityScore .

svod:hasGenre a owl:ObjectProperty ;
    rdfs:domain svod:Title ;
    rdfs:range svod:Genre .

svod:hasLifecycleSignal a owl:ObjectProperty ;
    rdfs:domain svod:Viewer ;
    rdfs:range svod:LifecycleSignal .

svod:hasSubscriptionEvent a owl:ObjectProperty ;
    rdfs:domain svod:Viewer ;
    rdfs:range svod:SubscriptionEvent .

svod:hasViewingEvent a owl:ObjectProperty ;
    rdfs:domain svod:Viewer ;
    rdfs:range svod:ViewingEvent .

svod:hasViewingSummary a owl:ObjectProperty ;
    rdfs:domain svod:Viewer ;
    rdfs:range svod:ViewingSummary .

svod:lifecycleStage a owl:DatatypeProperty ;
    rdfs:comment "One of: active, at_risk, churned." ;
    rdfs:domain svod:LifecycleSignal ;
    rdfs:range xsd:string .

svod:name a owl:DatatypeProperty ;
    rdfs:range xsd:string .

svod:onPlatform a owl:ObjectProperty ;
    rdfs:domain svod:ViewingEvent ;
    rdfs:range svod:Platform .

svod:primaryPlatform a owl:ObjectProperty ;
    rdfs:domain svod:ViewingSummary ;
    rdfs:range svod:Platform .

svod:subscribesTo a owl:ObjectProperty ;
    rdfs:comment "Viewer currently subscribes to Platform." ;
    rdfs:domain svod:Viewer ;
    rdfs:range svod:Platform .

svod:totalViewingMinutes a owl:DatatypeProperty ;
    rdfs:domain svod:ViewingSummary ;
    rdfs:range xsd:integer .

svod:viewedTitle a owl:ObjectProperty ;
    rdfs:domain svod:ViewingEvent ;
    rdfs:range svod:Title .

svod:viewer_001 a svod:Viewer ;
    svod:hasAffinityScore svod:affinity_viewer_001_brand_1,
